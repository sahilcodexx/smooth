---
import Layout from '../../layouts/Layout.astro';
import { neon } from '@neondatabase/serverless';

export const prerender = false;

const { id } = Astro.params;
const sql = neon(import.meta.env.DATABASE_URL);

// Fetch post from Neon database
const posts = await sql`SELECT * FROM posts WHERE id = ${id}`;
const post = posts[0];

if (!post) {
  return Astro.redirect('/404');
}

// Convert markdown to HTML on the server, or we can just render it. 
// Actually, typeset works great with raw markdown rendered to HTML. Let's use marked.
import { marked } from 'marked';
const htmlContent = marked(post.content);
---

<Layout>
  <main class="max-w-[37em]" style="margin: 6rem auto; padding: 2rem 1.25rem;">
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between;">
      <a href="/" style="text-decoration: none; padding: 0.5rem 1rem; color: var(--muted-foreground); font-family: 'Geist Variable', sans-serif;">&larr; Back home</a>
      <a href="/create" style="text-decoration: none; padding: 0.5rem 1rem; background-color: var(--foreground); color: var(--background); border-radius: 0.375rem; font-weight: 500; font-family: 'Geist Variable', sans-serif;">Write</a>
    </div>
    <div class="typeset typeset-article max-w-[37em]" set:html={htmlContent}></div>
  </main>
</Layout>
