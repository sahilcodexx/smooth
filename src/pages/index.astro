---
import Layout from '../layouts/Layout.astro';
import { neon } from '@neondatabase/serverless';
import { PostFeed } from '../components/PostFeed';
import { getSessionUser } from '../lib/auth';

export const prerender = false;

// Authenticate session
const user = await getSessionUser(Astro.request.headers.get('Cookie'));
if (!user) {
  return Astro.redirect('/auth');
}

let posts = [];
let error = null;

try {
  const sql = neon(import.meta.env.DATABASE_URL);
  // Fetch posts scoped strictly to the authenticated user
  posts = await sql`
    SELECT id, title, created_at
    FROM posts
    WHERE user_id = ${user.id}
    ORDER BY created_at DESC;
  `;
} catch (err) {
  console.error('Failed to fetch user posts:', err);
  error = 'Could not load posts. Make sure DATABASE_URL is configured.';
}
---

<Layout>
  {error && (
    <div style="max-width: 37em; margin: 6rem auto 0 auto; padding: 1rem; background-color: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0.5rem; color: #ef4444; font-size: 0.9rem; font-family: var(--font-geist);">
      {error}
    </div>
  )}
  <PostFeed initialPosts={posts} neonAuthUrl={import.meta.env.NEON_AUTH_BASE_URL} initialUser={{ id: user.id, email: user.email }} client:load />
</Layout>

<style is:global>
  .post-item:hover .post-title-link {
    color: #FF9500 !important;
  }
  .post-item {
    border-bottom: 1px solid var(--color-border) !important;
  }
  .post-item:hover {
    border-color: var(--color-muted-foreground) !important;
  }
</style>
