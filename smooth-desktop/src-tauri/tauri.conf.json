{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unmindful",
  "version": "0.1.0",
  "identifier": "app.smooth.unmindful.desktop",
  "build": {
    "frontendDist": "https://unmindful.vercel.app"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "unmindful",
        "url": "https://unmindful.vercel.app",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#09090b",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
