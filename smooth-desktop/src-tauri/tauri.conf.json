    "category": "Productivity",
    "shortDescription": "unmindful — where random thoughts find their home",
    "longDescription": "Desktop shell for the unmindful writing app. Same interface, backed by the live unmindful web service.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
